<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.FormularioFuncionController"
      spacing="25"
      styleClass="contenido-principal">

    <VBox spacing="5">
        <Label fx:id="tituloFormulario" text="Nueva función" styleClass="titulo-pagina"/>
        <Label text="Completá los datos de la función"
               styleClass="subtitulo-pagina"/>
    </VBox>

    <VBox spacing="10" styleClass="tarjeta-contenido" maxWidth="520">

        <Label text="Película" style="-fx-text-fill: #CBD5E1;"/>
        <ComboBox fx:id="comboPelicula" maxWidth="Infinity"/>

        <Label text="Sala" style="-fx-text-fill: #CBD5E1;"/>
        <ComboBox fx:id="comboSala" maxWidth="Infinity"/>

        <Label text="Fecha" style="-fx-text-fill: #CBD5E1;"/>
        <DatePicker fx:id="selectorFecha" maxWidth="Infinity"/>

        <Label text="Hora de inicio" style="-fx-text-fill: #CBD5E1;"/>
        <HBox spacing="10">
            <ComboBox fx:id="comboHora" prefWidth="100"/>
            <Label text=":" style="-fx-text-fill: #CBD5E1;"/>
            <ComboBox fx:id="comboMinutos" prefWidth="100"/>
        </HBox>

        <Label text="Precio" style="-fx-text-fill: #CBD5E1;"/>
        <TextField fx:id="campoPrecio" promptText="Ej: 5000"/>

        <Label text="Formato" style="-fx-text-fill: #CBD5E1;"/>
        <ComboBox fx:id="comboFormato" maxWidth="Infinity"/>

        <Label text="Idioma" style="-fx-text-fill: #CBD5E1;"/>
        <ComboBox fx:id="comboIdioma" maxWidth="Infinity"/>

        <Label fx:id="mensajeError" visible="false" managed="false"
               wrapText="true"
               style="-fx-text-fill: #EF4444;"/>

        <HBox spacing="10">
            <Button text="Cancelar"
                    styleClass="boton-secundario"
                    onAction="#cancelar"/>
            <Button fx:id="botonGuardar" text="Programar función"
                    styleClass="boton-primario"
                    onAction="#guardarFuncion"/>
        </HBox>
    </VBox>

</VBox>