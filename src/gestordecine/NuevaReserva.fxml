<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="gestordecine.NuevaReservaController"
            fitToWidth="true"
            style="-fx-background: transparent; -fx-background-color: transparent;">

    <VBox spacing="25" styleClass="contenido-principal">

        <VBox spacing="5">
            <Label text="Nueva reserva" styleClass="titulo-pagina"/>
            <Label text="Elegí la función, las butacas y los datos del cliente"
                   styleClass="subtitulo-pagina"/>
        </VBox>

        <HBox spacing="25">

            <!-- Izquierda: funcion, tipo de entrada y plano de butacas -->
            <VBox spacing="12" styleClass="tarjeta-contenido"
                  HBox.hgrow="ALWAYS">

                <Label text="Función" style="-fx-text-fill: #CBD5E1;"/>
                <ComboBox fx:id="comboFuncion" maxWidth="Infinity"/>

                <Label text="Tipo de entrada para las próximas butacas"
                       style="-fx-text-fill: #CBD5E1;"/>
                <ComboBox fx:id="comboTipoEntrada" maxWidth="Infinity"/>

                <!-- Leyenda -->
                <HBox spacing="15">
                    <HBox spacing="6">
                        <Region prefWidth="16" prefHeight="16"
                                style="-fx-background-color: #2B5F8A; -fx-background-radius: 4;"/>
                        <Label text="Libre" style="-fx-text-fill: #CBD5E1;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Region prefWidth="16" prefHeight="16"
                                style="-fx-background-color: #22C55E; -fx-background-radius: 4;"/>
                        <Label text="Seleccionada" style="-fx-text-fill: #CBD5E1;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Region prefWidth="16" prefHeight="16"
                                style="-fx-background-color: #6B7280; -fx-background-radius: 4;"/>
                        <Label text="Ocupada" style="-fx-text-fill: #CBD5E1;"/>
                    </HBox>
                </HBox>

                <VBox fx:id="contenedorButacas" spacing="12"/>
            </VBox>

            <!-- Derecha: resumen, cliente y confirmacion -->
            <VBox spacing="10" styleClass="tarjeta-contenido" prefWidth="360">

                <Label text="Tu reserva" styleClass="titulo-seccion"/>

                <ListView fx:id="listaEntradas" prefHeight="130"
                          styleClass="lista-salas"/>
                <Label fx:id="etiquetaTotal" text="Total: $0.0"
                       style="-fx-text-fill: white; -fx-font-weight: bold;"/>

                <Label text="Datos del cliente" styleClass="titulo-seccion"/>

                <Label text="DNI" style="-fx-text-fill: #CBD5E1;"/>
                <TextField fx:id="campoDni"/>
                <Label text="Nombre" style="-fx-text-fill: #CBD5E1;"/>
                <TextField fx:id="campoNombre"/>
                <Label text="Apellido" style="-fx-text-fill: #CBD5E1;"/>
                <TextField fx:id="campoApellido"/>
                <Label text="Email" style="-fx-text-fill: #CBD5E1;"/>
                <TextField fx:id="campoEmail"/>
                <Label text="Contraseña" style="-fx-text-fill: #CBD5E1;"/>
                <PasswordField fx:id="campoContrasenia"/>

                <Label fx:id="mensajeError" visible="false" managed="false"
                       wrapText="true"
                       style="-fx-text-fill: #EF4444;"/>

                <Button fx:id="botonConfirmar" text="Confirmar reserva"
                        styleClass="boton-primario"
                        maxWidth="Infinity"
                        onAction="#confirmarReserva"/>

                <TextArea fx:id="areaComprobante" visible="false" managed="false"
                          editable="false" prefRowCount="14"
                          style="-fx-font-family: monospace;"/>
            </VBox>

        </HBox>
    </VBox>
</ScrollPane>