<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.PeliculasController"
      spacing="25"
      styleClass="contenido-principal">

    <HBox alignment="CENTER_LEFT" spacing="20">

        <VBox spacing="8">
            <Label text="Administración de películas"
                   styleClass="titulo-pagina"/>
            <Label text="Gestioná las películas registradas en el cine"
                   styleClass="subtitulo-pagina"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Nueva película"
                styleClass="boton-primario"
                onAction="#nuevaPelicula"/>

    </HBox>

    <VBox spacing="15" styleClass="tarjeta-contenido">

        <Label text="Películas registradas"
               styleClass="titulo-seccion"/>

        <TableView fx:id="tablaPeliculas"
                   prefHeight="400"
                   styleClass="tabla-peliculas">

            <columns>
                <TableColumn fx:id="colTitulo"
                             text="Título"
                             prefWidth="300"/>

                <TableColumn fx:id="colDuracion"
                             text="Duración"
                             prefWidth="150"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="150"/>
            </columns>

        </TableView>

    </VBox>

</VBox>
