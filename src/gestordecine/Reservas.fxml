<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.ReservasController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5">
            <Label text="Reservas" styleClass="titulo-pagina"/>
            <Label text="Consultá, revisá el comprobante o cancelá una reserva"
                   styleClass="subtitulo-pagina"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nueva reserva"
                styleClass="boton-primario"
                onAction="#nuevaReserva"/>
    </HBox>

    <!-- Busqueda -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="tarjeta-contenido">
        <Label text="Buscar por" style="-fx-text-fill: #CBD5E1;"/>
        <ComboBox fx:id="comboCriterio" prefWidth="140"/>
        <TextField fx:id="campoBusqueda" prefWidth="260"
                   promptText="Dejalo vacío para ver todas"/>
        <Button text="Buscar" styleClass="boton-secundario"
                onAction="#buscar"/>
        <Button text="Ver todas" styleClass="boton-secundario"
                onAction="#verTodas"/>
    </HBox>

    <HBox spacing="25" VBox.vgrow="ALWAYS">

        <!-- Lista de reservas -->
        <VBox spacing="12" styleClass="tarjeta-contenido"
              HBox.hgrow="ALWAYS">
            <Label text="Reservas encontradas" styleClass="titulo-seccion"/>
            <ListView fx:id="listaReservas" styleClass="lista-salas"
                      VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Comprobante y cancelacion -->
        <VBox spacing="10" styleClass="tarjeta-contenido" prefWidth="420">
            <Label text="Comprobante" styleClass="titulo-seccion"/>
            <TextArea fx:id="areaComprobante" editable="false"
                      VBox.vgrow="ALWAYS"
                      style="-fx-font-family: monospace;"/>

            <Label fx:id="mensajeError" visible="false" managed="false"
                   wrapText="true"
                   style="-fx-text-fill: #EF4444;"/>

            <Button fx:id="botonCancelar" text="Cancelar reserva"
                    styleClass="boton-peligro"
                    maxWidth="Infinity"
                    onAction="#cancelarReserva"/>
        </VBox>

    </HBox>
</VBox>