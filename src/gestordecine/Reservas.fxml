<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.ReservasController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- ENCABEZADO PRINCIPAL -->
    <VBox spacing="10">

        <!-- PRIMERA FILA: INFORMACIÓN Y VOLVER -->
        <HBox alignment="CENTER_LEFT" spacing="20">

            <VBox spacing="8">

                <Label text="Reservas"
                       styleClass="titulo-pagina"/>

                <Label text="Consultá, revisá el comprobante o cancelá una reserva"
                       styleClass="subtitulo-pagina"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Volver"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="boton-secundario"
                    onAction="#volver"/>

        </HBox>

        <!-- SEGUNDA FILA: ACCIONES -->
        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="botonComprobante"
                    text="Ver comprobante"
                    prefWidth="145"
                    minWidth="145"
                    prefHeight="45"
                    styleClass="boton-secundario"
                    onAction="#verComprobante"/>

            <Button fx:id="botonCancelar"
                    text="Cancelar reserva"
                    prefWidth="160"
                    minWidth="160"
                    prefHeight="45"
                    styleClass="boton-peligro"
                    onAction="#cancelarReserva"/>

        </HBox>

    </VBox>

    <!-- PANEL DE RESERVAS -->
    <VBox spacing="12"
          styleClass="tarjeta-contenido"
          VBox.vgrow="ALWAYS">

        <!-- PRIMERA FILA: TÍTULO Y EXPORTACIÓN -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <Label text="Reservas encontradas"
                   styleClass="titulo-seccion"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Exportar CSV"
                    styleClass="boton-secundario"
                    onAction="#exportarCSV"/>

        </HBox>

        <!-- SEGUNDA FILA: FILTROS DE BÚSQUEDA -->
        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <Label text="Buscar por"
                   style="-fx-text-fill: #CBD5E1;"/>

            <ComboBox fx:id="comboCriterio"
                      prefWidth="140"/>

            <TextField fx:id="campoBusqueda"
                       prefWidth="260"
                       promptText="Dejalo vacío para ver todas"/>

            <Button text="Buscar"
                    styleClass="boton-secundario"
                    onAction="#buscar"/>

            <Button text="Ver todas"
                    styleClass="boton-secundario"
                    onAction="#verTodas"/>

        </HBox>

        <!-- TERCERA FILA: TABLA ADMINISTRATIVA -->
        <TableView fx:id="listaReservas"
                   VBox.vgrow="ALWAYS"
                   styleClass="tabla-peliculas, tabla-reservas">

            <columns>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             minWidth="65"
                             prefWidth="65"/>

                <TableColumn fx:id="colCodigo"
                             text="Código"
                             minWidth="85"
                             prefWidth="95"/>

                <TableColumn fx:id="colPelicula"
                             text="Película"
                             minWidth="230"
                             prefWidth="360"/>

                <TableColumn fx:id="colFecha"
                             text="Fecha y hora"
                             minWidth="145"
                             prefWidth="165"/>

                <TableColumn fx:id="colSala"
                             text="Sala"
                             minWidth="85"
                             prefWidth="100"/>

                <TableColumn fx:id="colCliente"
                             text="Cliente"
                             minWidth="150"
                             prefWidth="200"/>

                <TableColumn fx:id="colDni"
                             text="DNI"
                             minWidth="100"
                             prefWidth="115"/>

                <TableColumn fx:id="colEntradas"
                             text="Entradas"
                             minWidth="80"
                             prefWidth="95"/>

                <TableColumn fx:id="colTotal"
                             text="Total"
                             minWidth="125"
                             prefWidth="145"/>

            </columns>

        </TableView>

        <!-- MENSAJE DE ERROR -->
        <Label fx:id="mensajeError"
               visible="false"
               managed="false"
               wrapText="true"
               style="-fx-text-fill: #EF4444;"/>

    </VBox>

</VBox>
