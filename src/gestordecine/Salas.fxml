<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.SalasController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- ENCABEZADO -->

    <VBox spacing="15">

        <!-- Fila superior: título y botones -->
        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Button text="Editar sala"
                    prefWidth="145"
                    minWidth="145"
                    maxWidth="145"
                    prefHeight="45"
                    styleClass="boton-secundario"
                    onAction="#editarSala"/>

            <Button fx:id="botonEstado"
                    text="Desactivar sala"
                    prefWidth="160"
                    minWidth="160"
                    maxWidth="160"
                    prefHeight="45"
                    styleClass="boton-peligro"
                    onAction="#cambiarEstadoSala"/>

            <Button text="+ Nueva sala"
                    prefWidth="150"
                    minWidth="150"
                    maxWidth="150"
                    prefHeight="45"
                    styleClass="boton-primario"
                    onAction="#nuevaSala"/>

        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8">

            <Label text="Gestioná las salas y su distribución de butacas"
                   styleClass="subtitulo-pagina"/>

            <Region minWidth="50" prefWidth="35"/>

            <Label text="Estado:"
                   styleClass="subtitulo-pagina"/>

            <ComboBox fx:id="filtroEstado"
                      prefWidth="130"
                      styleClass="filtro-estado"/>

        </HBox>
    </VBox>
    
    <Label fx:id="mensajeError"
           text=""
           visible="false"
           managed="false"
           wrapText="true"
           styleClass="mensaje-error"/>

    <!-- CONTENIDO -->

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- LISTADO DE SALAS -->

        <VBox spacing="15"
              prefWidth="420"
              styleClass="tarjeta-contenido">

            <VBox spacing="8">

                <Label text="Salas registradas"
                       styleClass="titulo-seccion"/>

            </VBox>
            
            <TableView fx:id="tablaSalas"
                       VBox.vgrow="ALWAYS"
                       styleClass="tabla-peliculas">

                <columns>
                    <TableColumn fx:id="columnaId"
                                 text="ID"
                                 prefWidth="45"/>

                    <TableColumn fx:id="columnaEstado"
                                 text="Estado"
                                 prefWidth="70"/>

                    <TableColumn fx:id="columnaNombre"
                                 text="Nombre"
                                 prefWidth="135"/>

                    <TableColumn fx:id="columnaCapacidad"
                                 text="Capacidad"
                                 prefWidth="95"/>
                </columns>

            </TableView>

        </VBox>

        <!-- DISTRIBUCION DE BUTACAS -->

        <VBox spacing="20"
              HBox.hgrow="ALWAYS"
              styleClass="tarjeta-contenido">

            <Label text="Distribución de butacas"
                   styleClass="titulo-seccion"/>

            <Label fx:id="nombreSalaSeleccionada"
                   text="Seleccioná una sala para ver su distribución"
                   styleClass="subtitulo-pagina"/>

            <VBox fx:id="contenedorButacas"
                  alignment="TOP_CENTER"
                  spacing="12"
                  VBox.vgrow="ALWAYS"/>

            <Label fx:id="cantidadButacas"
                   text=""
                   styleClass="subtitulo-pagina"/>

        </VBox>

    </HBox>

</VBox>
