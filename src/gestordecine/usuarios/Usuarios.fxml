<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>

<!--
    Pantalla de administración de usuarios (solo para administradores):
    tabla con los usuarios registrados, búsqueda, filtro por rol y botones
    para crear, editar y activar o desactivar usuarios.
    La controla UsuariosController.
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.usuarios.UsuariosController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- ENCABEZADO PRINCIPAL -->
    <VBox spacing="10">

        <!-- PRIMERA FILA: INFORMACIÓN Y VOLVER -->
        <HBox alignment="CENTER_LEFT" spacing="20">

            <VBox spacing="8">

                <Label text="Administración de usuarios"
                       styleClass="titulo-pagina"/>

                <Label text="Gestioná los usuarios registrados y sus permisos"
                       styleClass="subtitulo-pagina"/>

            </VBox>

            <!-- Espacio flexible: empuja el botón Volver hacia la derecha -->
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Volver"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="boton-secundario"
                    onAction="#volver"/>

        </HBox>

        <!-- SEGUNDA FILA: ACCIONES -->
        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Editar usuario"
                    prefWidth="145"
                    minWidth="145"
                    prefHeight="45"
                    styleClass="boton-secundario"
                    onAction="#editarUsuario"/>

            <!-- El controlador cambia su texto según el usuario seleccionado
                 (Desactivar o Reactivar) -->
            <Button fx:id="botonEstado"
                    text="Desactivar usuario"
                    prefWidth="160"
                    minWidth="160"
                    prefHeight="45"
                    styleClass="boton-peligro"
                    onAction="#cambiarEstadoUsuario"/>

            <Button text="+ Nuevo usuario"
                    prefWidth="175"
                    minWidth="175"
                    prefHeight="45"
                    styleClass="boton-primario"
                    onAction="#nuevoUsuario"/>

        </HBox>

    </VBox>

    <!-- PANEL DE USUARIOS -->
    <VBox spacing="12"
          styleClass="tarjeta-contenido"
          VBox.vgrow="ALWAYS">

        <!-- TÍTULO Y CONTADOR -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <Label text="Usuarios registrados"
                   styleClass="titulo-seccion"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="etiquetaCantidad"
                   styleClass="subtitulo-pagina"/>

        </HBox>

        <!-- FILTROS: búsqueda por texto y filtro por rol -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <TextField fx:id="campoBusqueda"
                       promptText="Buscar por DNI, nombre, apellido o correo..."
                       prefWidth="360"
                       styleClass="campo-cinema"/>

            <ComboBox fx:id="filtroRol"
                      prefWidth="200"/>

        </HBox>

        <!-- MENSAJE DE ERROR -->
        <Label fx:id="mensajeEstado"
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="mensaje-error"/>

        <!-- TABLA: las columnas se completan desde UsuariosController -->
        <TableView fx:id="tablaUsuarios"
                   VBox.vgrow="ALWAYS"
                   styleClass="tabla-peliculas, tabla-admin-usuarios">

            <columns>

                <TableColumn fx:id="columnaEstado"
                             text="Estado"
                             minWidth="75"
                             prefWidth="75"
                             maxWidth="75"/>

                <TableColumn fx:id="columnaDni"
                             text="DNI"
                             minWidth="120"
                             prefWidth="120"
                             maxWidth="120"/>

                <TableColumn fx:id="columnaNombre"
                             text="Nombre"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaApellido"
                             text="Apellido"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaEmail"
                             text="Correo electrónico"
                             prefWidth="250"/>

                <TableColumn fx:id="columnaRol"
                             text="Rol"
                             prefWidth="160"/>

            </columns>

        </TableView>

    </VBox>

</VBox>