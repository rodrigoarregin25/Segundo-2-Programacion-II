<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.usuarios.UsuariosController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- ENCABEZADO PRINCIPAL -->
    <VBox spacing="10">

        <HBox alignment="CENTER_LEFT" spacing="20">

            <VBox spacing="8">

                <Label text="Administración de usuarios"
                       styleClass="titulo-pagina"/>

                <Label text="Consultá los usuarios registrados y sus permisos"
                       styleClass="subtitulo-pagina"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Volver"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="boton-secundario"
                    onAction="#volver"/>

        </HBox>

    </VBox>

    <!-- LISTADO DE USUARIOS -->
    <VBox spacing="12"
          styleClass="tarjeta-contenido"
          VBox.vgrow="ALWAYS">

        <!-- ENCABEZADO Y CONTADOR -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <Label text="Usuarios registrados"
                   styleClass="titulo-seccion"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="etiquetaCantidad"
                   styleClass="subtitulo-pagina"/>

        </HBox>

        <!-- FILTROS DE USUARIOS -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <TextField fx:id="campoBusqueda"
                       promptText="Buscar por DNI, nombre, apellido o correo..."
                       prefWidth="360"
                       styleClass="campo-cinema"/>

            <ComboBox fx:id="filtroRol"
                      prefWidth="200"/>

        </HBox>
        
        <!-- ACCIONES SOBRE USUARIOS -->
        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Editar usuario"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="boton-secundario"
                    onAction="#editarUsuario"/>

        </HBox>
        
        <Label fx:id="mensajeEstado"
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="subtitulo-pagina"/>

        <TableView fx:id="tablaUsuarios"
                   VBox.vgrow="ALWAYS"
                   styleClass="tabla-peliculas">

            <columns>

                <TableColumn fx:id="columnaDni"
                             text="DNI"
                             prefWidth="100"/>

                <TableColumn fx:id="columnaNombre"
                             text="Nombre"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaApellido"
                             text="Apellido"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaEmail"
                             text="Correo electrónico"
                             prefWidth="240"/>

                <TableColumn fx:id="columnaRol"
                             text="Rol"
                             prefWidth="150"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
