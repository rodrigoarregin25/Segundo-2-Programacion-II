<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.FuncionesController"
      spacing="25"
      styleClass="contenido-principal">

    <VBox spacing="5">
        <Label text="Funciones" styleClass="titulo-pagina"/>
        <Label text="Programá las funciones de cada sala"
               styleClass="subtitulo-pagina"/>
    </VBox>

    <HBox spacing="25" VBox.vgrow="ALWAYS">

        <!-- Lista de funciones programadas -->
        <VBox spacing="12" styleClass="tarjeta-contenido"
              HBox.hgrow="ALWAYS">
            <Label text="Funciones programadas" styleClass="titulo-seccion"/>
            <ListView fx:id="listaFunciones" styleClass="lista-salas"
                      VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Formulario para programar una funcion -->
        <VBox spacing="10" styleClass="tarjeta-contenido" prefWidth="360">
            <Label text="Nueva función" styleClass="titulo-seccion"/>

            <Label text="Película" style="-fx-text-fill: #CBD5E1;"/>
            <ComboBox fx:id="comboPelicula" maxWidth="Infinity"/>

            <Label text="Sala" style="-fx-text-fill: #CBD5E1;"/>
            <ComboBox fx:id="comboSala" maxWidth="Infinity"/>

            <Label text="Fecha" style="-fx-text-fill: #CBD5E1;"/>
            <DatePicker fx:id="selectorFecha" maxWidth="Infinity"/>

            <Label text="Hora de inicio" style="-fx-text-fill: #CBD5E1;"/>
            <HBox spacing="10">
                <ComboBox fx:id="comboHora" prefWidth="100"/>
                <Label text=":" style="-fx-text-fill: #CBD5E1;"/>
                <ComboBox fx:id="comboMinutos" prefWidth="100"/>
            </HBox>

            <Label text="Precio" style="-fx-text-fill: #CBD5E1;"/>
            <TextField fx:id="campoPrecio" promptText="Ej: 5000"/>

            <Label text="Formato" style="-fx-text-fill: #CBD5E1;"/>
            <ComboBox fx:id="comboFormato" maxWidth="Infinity"/>

            <Label text="Idioma" style="-fx-text-fill: #CBD5E1;"/>
            <ComboBox fx:id="comboIdioma" maxWidth="Infinity"/>

            <Label fx:id="mensajeError" visible="false" managed="false"
                   wrapText="true"
                   style="-fx-text-fill: #EF4444;"/>

            <Button text="Programar función"
                    styleClass="boton-primario"
                    maxWidth="Infinity"
                    onAction="#programarFuncion"/>
        </VBox>

    </HBox>
</VBox>