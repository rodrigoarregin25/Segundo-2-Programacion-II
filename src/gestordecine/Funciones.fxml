<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.FuncionesController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- ENCABEZADO PRINCIPAL -->
    <VBox spacing="16">

        <!-- PRIMERA FILA: TITULO Y BOTONES -->
        <HBox alignment="CENTER_LEFT" spacing="20">

            <Label text="Administración de funciones"
                   styleClass="titulo-pagina"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="12">

                <Button text="Editar precio"
                        prefWidth="145"
                        minWidth="145"
                        maxWidth="145"
                        prefHeight="45"
                        styleClass="boton-secundario"
                        onAction="#editarFuncion"/>

                <Button fx:id="botonEstado"
                        text="Desactivar función"
                        prefWidth="160"
                        minWidth="160"
                        maxWidth="160"
                        prefHeight="45"
                        styleClass="boton-peligro"
                        onAction="#cambiarEstadoFuncion"/>

                <Button text="+ Nueva función"
                        prefWidth="150"
                        minWidth="150"
                        maxWidth="150"
                        prefHeight="45"
                        styleClass="boton-primario"
                        onAction="#nuevaFuncion"/>

            </HBox>

        </HBox>

        <!-- SEGUNDA FILA: SUBTITULO -->
        <HBox alignment="CENTER_LEFT">

            <Label text="Gestioná las funciones programadas en cada sala"
                   styleClass="subtitulo-pagina"/>

        </HBox>

    </VBox>

    <!-- PANEL DE FUNCIONES -->
    <VBox spacing="12"
          styleClass="tarjeta-contenido"
          VBox.vgrow="ALWAYS">

        <!-- TITULO Y FILTRO -->
        <HBox alignment="CENTER_LEFT" spacing="10">

            <Label text="Funciones programadas"
                   styleClass="titulo-seccion"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Estado:"
                   style="-fx-text-fill: #CBD5E1;"/>

            <ComboBox fx:id="filtroEstado"/>

        </HBox>

        <!-- LISTADO DE FUNCIONES -->
        <ListView fx:id="listaFunciones"
                  styleClass="lista-salas"
                  VBox.vgrow="ALWAYS"/>

        <!-- MENSAJE DE ERROR -->
        <Label fx:id="mensajeError"
               visible="false"
               managed="false"
               wrapText="true"
               style="-fx-text-fill: #EF4444;"/>

    </VBox>

</VBox>
