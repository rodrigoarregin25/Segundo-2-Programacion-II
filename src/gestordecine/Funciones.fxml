<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.FuncionesController"
      spacing="25"
      styleClass="contenido-principal">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Administración de funciones" styleClass="titulo-pagina"/>
            <Label text="Gestioná las funciones programadas en cada sala"
                   styleClass="subtitulo-pagina"/>
        </VBox>

        <Button text="Editar precio"
                styleClass="boton-secundario"
                onAction="#editarFuncion"/>
        <Button fx:id="botonEstado" text="Desactivar función"
                styleClass="boton-peligro"
                onAction="#cambiarEstadoFuncion"/>
        <Button text="+ Nueva función"
                styleClass="boton-primario"
                onAction="#nuevaFuncion"/>
    </HBox>

    <VBox spacing="12" styleClass="tarjeta-contenido" VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Funciones programadas" styleClass="titulo-seccion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Estado:" style="-fx-text-fill: #CBD5E1;"/>
            <ComboBox fx:id="filtroEstado"/>
        </HBox>

        <ListView fx:id="listaFunciones" styleClass="lista-salas"
                  VBox.vgrow="ALWAYS"/>

        <Label fx:id="mensajeError" visible="false" managed="false"
               wrapText="true"
               style="-fx-text-fill: #EF4444;"/>
    </VBox>

</VBox>