<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Pantalla de cartelera: muestra una tarjeta por cada película activa y
    permite filtrarlas por título, género y fecha.
    La controla CarteleraController.
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.controladores.CarteleraController"
      spacing="20"
      styleClass="contenido-principal">

    <!-- ENCABEZADO -->
    <Label text="Cartelera"
           styleClass="titulo-pagina"/>

    <Label text="Descubrí las películas disponibles en nuestro cine"
           styleClass="subtitulo-pagina"/>
    

    <!-- FILTROS: título, género y fecha. Al cambiar cualquiera, el
         controlador vuelve a armar las tarjetas -->
    <HBox alignment="CENTER_LEFT"
          spacing="15"
          styleClass="filtros-cartelera">

        <TextField fx:id="campoBusqueda"
                   promptText="Buscar película..."
                   prefWidth="300"
                   minHeight="40"
                   maxHeight="40"
                   styleClass="filtro-cartelera-unificado"/>

        <ComboBox fx:id="filtroGenero"
                  prefWidth="200"
                  minHeight="40"
                  maxHeight="40"
                  promptText="Todos los géneros"
                  styleClass="filtro-cartelera-unificado"/>

        <DatePicker fx:id="filtroFecha"
                    prefWidth="170"
                    minHeight="40"
                    maxHeight="40"
                    promptText="Todas las fechas"
                    styleClass="filtro-cartelera-unificado"/>

        <!-- Botón con ícono de tacho: quita el filtro de fecha (limpiarFecha).
             El ícono es un dibujo vectorial (SVGPath), no una imagen -->
        <Button prefWidth="40"
                minWidth="40"
                maxWidth="40"
                prefHeight="40"
                minHeight="40"
                maxHeight="40"
                styleClass="boton-limpiar-unificado"
                onAction="#limpiarFecha">

            <graphic>
                <SVGPath
                    content="M3 6h18 M8 6V4h8v2 M5 6l1 15h12l1-15 M10 10v7 M14 10v7"
                    fill="TRANSPARENT"
                    stroke="WHITE"
                    strokeWidth="1.7"/>
            </graphic>

        </Button>

    </HBox>


    <!-- LISTA DE PELÍCULAS: con scroll vertical, sin barra horizontal -->
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                styleClass="scroll-cartelera">

        <!-- Las tarjetas se agregan desde Java (mostrarPeliculas). El FlowPane
             las acomoda en filas y baja a la siguiente cuando no hay lugar -->
        <FlowPane fx:id="contenedorPeliculas"
                  hgap="20"
                  vgap="20"
                  prefWrapLength="900"
                  styleClass="contenedor-cartelera"/>

    </ScrollPane>

</VBox>