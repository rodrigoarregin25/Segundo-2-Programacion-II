
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.shape.SVGPath?>

<!--
    ADMINISTRACIÓN DE FUNCIONES

    Define la interfaz para visualizar y administrar las funciones
    programadas en el cine.

    Permite registrar nuevas funciones, editar las existentes,
    cambiar su estado y consultar los datos mediante una tabla.

    También incorpora filtros combinados por película, fecha y estado.

    La lógica de navegación, filtrado y modificación de funciones
    se encuentra en FuncionesController.
-->

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.controladores.FuncionesController"
      spacing="25"
      styleClass="contenido-principal">

    <!--
        ENCABEZADO PRINCIPAL

        Contiene el título de la pantalla, el botón para regresar
        y las acciones de administración de funciones.
    -->

    <VBox spacing="10">

        <!-- PRIMERA FILA: INFORMACIÓN Y NAVEGACIÓN -->

        <HBox alignment="CENTER_LEFT" spacing="20">

            <VBox spacing="8">

                <Label text="Administración de funciones"
                       styleClass="titulo-pagina"/>

                <Label text="Gestioná las funciones programadas en cada sala"
                       styleClass="subtitulo-pagina"/>

            </VBox>

            <!-- Espacio flexible que desplaza el botón hacia la derecha. -->
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Volver"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="boton-secundario"
                    onAction="#volver"/>

        </HBox>

        <!--
            SEGUNDA FILA: ACCIONES

            Editar función: abre el formulario de edición.
            Desactivar/Restaurar: modifica el estado de la función.
            Nueva función: abre el formulario de registro.

            Las validaciones y operaciones se ejecutan
            desde FuncionesController.
        -->

        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Editar función"
                    prefWidth="145"
                    minWidth="145"
                    prefHeight="45"
                    styleClass="boton-secundario"
                    onAction="#editarFuncion"/>

            <Button fx:id="botonEstado"
                    text="Desactivar función"
                    prefWidth="160"
                    minWidth="160"
                    prefHeight="45"
                    styleClass="boton-peligro"
                    onAction="#cambiarEstadoFuncion"/>

            <Button text="+ Nueva función"
                    prefWidth="175"
                    minWidth="175"
                    prefHeight="45"
                    styleClass="boton-primario"
                    onAction="#nuevaFuncion"/>

        </HBox>

    </VBox>

    <!--
        PANEL PRINCIPAL DE FUNCIONES

        Agrupa el título del listado, los filtros, la tabla
        administrativa y los mensajes de error.

        VBox.vgrow permite que el panel aproveche el espacio
        vertical disponible.
    -->

    <VBox spacing="12"
          styleClass="tarjeta-contenido"
          VBox.vgrow="ALWAYS">

        <!-- TÍTULO DEL LISTADO -->

        <HBox alignment="CENTER_LEFT" spacing="10">

            <Label text="Funciones programadas"
                   styleClass="titulo-seccion"/>

        </HBox>

        <!--
            FILTROS DE FUNCIONES

            Permiten combinar los criterios de película, fecha y estado.

            Los ComboBox y el DatePicker se vinculan con atributos
            del controlador mediante fx:id.
        -->

        <HBox alignment="CENTER_LEFT"
              spacing="12">

            <!-- Filtro por película. -->
            <ComboBox fx:id="filtroPelicula"
                      prefWidth="350"
                      promptText="Todas las películas"
                      styleClass="filtro-cartelera-unificado"/>

            <!-- Filtro por fecha de la función. -->
            <DatePicker fx:id="filtroFecha"
                        prefWidth="185"
                        promptText="Todas las fechas"
                        editable="false"
                        styleClass="filtro-cartelera-unificado"/>

            <!--
                BOTÓN PARA LIMPIAR FILTROS

                Ejecuta limpiarFiltros() desde el controlador.

                Utiliza un SVGPath para mostrar el ícono
                de eliminación sin depender de una imagen externa.
            -->

            <Button prefWidth="40"
                    minWidth="40"
                    maxWidth="40"
                    prefHeight="40"
                    minHeight="40"
                    maxHeight="40"
                    styleClass="boton-limpiar-unificado"
                    onAction="#limpiarFiltros">

                <graphic>
                    <SVGPath
                        content="M3 6h18 M8 6V4h8v2 M5 6l1 15h12l1-15 M10 10v7 M14 10v7"
                        fill="TRANSPARENT"
                        stroke="WHITE"
                        strokeWidth="1.7"/>
                </graphic>

            </Button>

            <!-- Separa los filtros principales del filtro de estado. -->
            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Estado:"
                   style="-fx-text-fill: #CBD5E1;"/>

            <!-- Filtro por estado: activas, inactivas o todas. -->
            <ComboBox fx:id="filtroEstado"
                      prefWidth="130"
                      styleClass="filtro-estado"/>

        </HBox>

        <!--
            TABLA ADMINISTRATIVA

            Muestra las funciones registradas y sus principales datos.

            Cada TableColumn está vinculada con su atributo
            correspondiente en FuncionesController.

            El controlador configura cómo se obtienen y presentan
            los valores de cada columna.
        -->

        <TableView fx:id="listaFunciones"
                   VBox.vgrow="ALWAYS"
                   styleClass="tabla-peliculas, tabla-admin-funciones">

            <columns>

                <!-- Estado de activación de la función. -->
                <TableColumn fx:id="colEstado"
                             text="Estado"
                             minWidth="40"
                             prefWidth="40"/>

                <!-- Película que se proyectará. -->
                <TableColumn fx:id="colPelicula"
                             text="Película"
                             minWidth="230"
                             prefWidth="350"/>

                <!-- Sala asignada a la función. -->
                <TableColumn fx:id="colSala"
                             text="Sala"
                             minWidth="90"
                             prefWidth="105"/>

                <!-- Fecha de la función. -->
                <TableColumn fx:id="colFecha"
                             text="Fecha"
                             minWidth="115"
                             prefWidth="130"/>

                <!-- Hora de inicio de la función. -->
                <TableColumn fx:id="colHora"
                             text="Hora"
                             minWidth="75"
                             prefWidth="90"/>

                <!-- Formato de proyección. -->
                <TableColumn fx:id="colFormato"
                             text="Formato"
                             minWidth="90"
                             prefWidth="105"/>

                <!-- Idioma de la película. -->
                <TableColumn fx:id="colIdioma"
                             text="Idioma"
                             minWidth="155"
                             prefWidth="190"/>

                <!-- Precio base de la función. -->
                <TableColumn fx:id="colPrecio"
                             text="Precio"
                             minWidth="120"
                             prefWidth="145"/>

            </columns>

        </TableView>

        <!--
            MENSAJES DE ERROR

            Permanece oculto inicialmente.
            El controlador modifica el texto y su visibilidad
            cuando una operación no puede realizarse.
        -->

        <Label fx:id="mensajeError"
               visible="false"
               managed="false"
               wrapText="true"
               style="-fx-text-fill: #EF4444;"/>

    </VBox>

</VBox>
