<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.controladores.PeliculasController"
      spacing="25"
      styleClass="contenido-principal">

    <!-- ENCABEZADO PRINCIPAL -->
    <VBox spacing="10">

        <!-- PRIMERA FILA: INFORMACIÓN Y VOLVER -->
        <HBox alignment="CENTER_LEFT" spacing="20">

            <VBox spacing="8">
                <Label text="Administración de películas"
                       styleClass="titulo-pagina"/>

                <Label text="Gestioná las películas registradas en el cine"
                       styleClass="subtitulo-pagina"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Volver"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="boton-secundario"
                    onAction="#volver"/>

        </HBox>

        <!-- SEGUNDA FILA: ACCIONES -->
        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Editar película"
                    prefWidth="145"
                    minWidth="145"
                    prefHeight="45"
                    styleClass="boton-secundario"
                    onAction="#editarPelicula"/>

            <Button fx:id="botonEstado"
                    text="Desactivar película"
                    prefWidth="160"
                    minWidth="160"
                    prefHeight="45"
                    styleClass="boton-peligro"
                    onAction="#desactivarPelicula"/>

            <Button text="+ Nueva película"
                    prefWidth="175"
                    minWidth="175"
                    prefHeight="45"
                    styleClass="boton-primario"
                    onAction="#nuevaPelicula"/>

        </HBox>

    </VBox>

    <!-- PANEL DE PELÍCULAS -->
    <VBox spacing="15"
          VBox.vgrow="ALWAYS"
          styleClass="tarjeta-contenido">

        <!-- TÍTULO Y FILTRO -->
        <HBox alignment="CENTER_LEFT" spacing="12">

            <Label text="Películas registradas"
                   styleClass="titulo-seccion"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Estado:"
                   styleClass="subtitulo-pagina"/>

            <ComboBox fx:id="filtroEstado"
                      prefWidth="130"
                      styleClass="filtro-estado"/>

        </HBox>

        <!-- TABLA -->
        <TableView fx:id="tablaPeliculas"
                   VBox.vgrow="ALWAYS"
                   styleClass="tabla-peliculas, tabla-admin-peliculas">

            <columns>

                <TableColumn fx:id="colEstado"
                             id="columna-estado"
                             text="Estado"
                             minWidth="65"
                             prefWidth="65"/>

                <TableColumn fx:id="colTitulo"
                             text="Título"
                             prefWidth="400"/>

                <TableColumn fx:id="colDuracion"
                             text="Duración"
                             prefWidth="110"/>

                <TableColumn fx:id="colFechaEstreno"
                             text="Año"
                             prefWidth="90"/>

                <TableColumn fx:id="colGenero"
                             text="Género"
                             prefWidth="300"/>

                <TableColumn fx:id="colDirector"
                             text="Director"
                             prefWidth="180"/>

                <TableColumn fx:id="colClasificacion"
                             text="Clasificación"
                             prefWidth="120"/>

                <TableColumn fx:id="colPuntuacion"
                             text="Puntuación"
                             prefWidth="110"/>

            </columns>

        </TableView>

        <!-- MENSAJE DE ERROR -->
        <Label fx:id="mensajeEstado"
               text=""
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="mensaje-error"/>

    </VBox>

</VBox>
