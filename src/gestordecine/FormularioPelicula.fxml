<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.FlowPane?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="gestordecine.FormularioPeliculaController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="scroll-formulario">

    <VBox spacing="16" styleClass="contenido-formulario-compacto">

        <VBox spacing="5">
            <Label fx:id="tituloFormulario"
                   text="Registrar película"
                   styleClass="titulo-pagina"/>
            <Label text="Completá la información para la cartelera"
                   styleClass="subtitulo-pagina"/>
        </VBox>

        <VBox spacing="14"
              maxWidth="850"
              styleClass="tarjeta-formulario-compacto">

            <Label text="Información general"
                   styleClass="titulo-seccion"/>

            <VBox spacing="5">
                <Label text="Título de la película"
                       styleClass="etiqueta-formulario"/>
                <TextField fx:id="campoTitulo"
                           promptText="Ej: Interestelar"
                           styleClass="campo-formulario"/>
            </VBox>

            <GridPane hgap="16" vgap="12">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- PRIMERA FILA: DURACIÓN Y AÑO -->

                <VBox spacing="5"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <Label text="Duración (minutos)"
                           styleClass="etiqueta-formulario"/>

                    <TextField fx:id="campoDuracion"
                               promptText="Ej: 169"
                               styleClass="campo-formulario"/>

                </VBox>

                <VBox spacing="5"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <Label text="Año de estreno"
                           styleClass="etiqueta-formulario"/>

                    <TextField fx:id="campoAnio"
                               promptText="Ej: 2014"
                               styleClass="campo-formulario"/>

                </VBox>

                <!-- SEGUNDA FILA: DIRECTOR Y CLASIFICACIÓN -->

                <VBox spacing="5"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="1">

                    <Label text="Director"
                           styleClass="etiqueta-formulario"/>

                    <TextField fx:id="campoDirector"
                               promptText="Nombre del director"
                               styleClass="campo-formulario"/>

                </VBox>

                <VBox spacing="5"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1">

                    <Label text="Clasificación"
                           styleClass="etiqueta-formulario"/>

                    <TextField fx:id="campoClasificacion"
                               promptText="ATP, +13, +16"
                               styleClass="campo-formulario"/>

                </VBox>

                <!-- TERCERA FILA: PUNTUACIÓN -->

                <VBox spacing="5"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="2"
                      GridPane.columnSpan="2">

                    <Label text="Puntuación (0 a 10)"
                           styleClass="etiqueta-formulario"/>

                    <TextField fx:id="campoPuntuacion"
                               promptText="Ej: 8.5"
                               styleClass="campo-formulario"/>

                </VBox>

                <!-- CUARTA FILA: GÉNEROS A ANCHO COMPLETO -->

                <VBox spacing="10"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="3"
                      GridPane.columnSpan="2"
                      maxWidth="Infinity">

                    <Label text="Géneros"
                           styleClass="etiqueta-formulario"/>

                    <FlowPane fx:id="contenedorGeneros"
                              hgap="10"
                              vgap="10"
                              maxWidth="Infinity"
                              styleClass="contenedor-generos"/>

                </VBox>

            </GridPane>

            <Label text="Información para la cartelera"
                   styleClass="titulo-seccion"/>

            <VBox spacing="5">
                <Label text="Actores principales" styleClass="etiqueta-formulario"/>
                <TextField fx:id="campoActores"
                           promptText="Separados por comas"
                           styleClass="campo-formulario"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Sinopsis"
                       styleClass="etiqueta-formulario"/>

                <TextArea fx:id="campoSinopsis"
                          prefRowCount="6"
                          prefHeight="150"
                          minHeight="150"
                          wrapText="true"
                          promptText="Descripción de la película"
                          styleClass="campo-formulario"/>
            </VBox>

            <!-- POSTER -->

            <VBox spacing="10">

                <Label text="Póster de la película"
                       styleClass="etiqueta-formulario"/>

                <HBox spacing="20" alignment="CENTER_LEFT">

                    <ImageView fx:id="vistaPoster"
                               fitWidth="100"
                               fitHeight="145"
                               preserveRatio="true"/>

                    <VBox spacing="10">

                        <Button text="Seleccionar imagen"
                                styleClass="boton-secundario"
                                onAction="#seleccionarPoster"/>

                        <Label fx:id="nombrePoster"
                               text="Ninguna imagen seleccionada"
                               styleClass="subtitulo-pagina"/>

                        <Label text="Formatos admitidos: JPG y PNG"
                               styleClass="subtitulo-pagina"/>

                    </VBox>

                </HBox>

            </VBox>

            <Label fx:id="mensajeError"
                   text=""
                   wrapText="true"
                   styleClass="mensaje-error"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancelar"
                        styleClass="boton-secundario"
                        onAction="#cancelar"/>
                <Button fx:id="botonGuardar"
                        text="Guardar película"
                        styleClass="boton-primario"
                        onAction="#guardarPelicula"/>
            </HBox>

        </VBox>

    </VBox>

</ScrollPane>
