<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="gestordecine.FormularioSalaController"
      spacing="20"
      styleClass="contenido-principal">

    <!-- ENCABEZADO -->

    <VBox spacing="8">
        <Label fx:id="tituloFormulario"
               text="Registrar sala"
               styleClass="titulo-pagina"/>

        <Label text="Configurá la capacidad y distribución de la sala"
               styleClass="subtitulo-pagina"/>
    </VBox>

    <!-- FORMULARIO -->

    <VBox spacing="18"
          maxWidth="650"
          styleClass="tarjeta-contenido">

        <Label text="Información de la sala"
               styleClass="titulo-seccion"/>

        <VBox spacing="8">
            <Label text="Nombre de la sala"
                   styleClass="etiqueta-formulario"/>

            <TextField fx:id="campoNombre"
                       promptText="Ej: Sala Premium"
                       styleClass="campo-formulario"/>
        </VBox>

        <HBox spacing="15">

            <VBox spacing="8" HBox.hgrow="ALWAYS">

                <Label text="Cantidad de filas"
                       styleClass="etiqueta-formulario"/>

                <TextField fx:id="campoFilas"
                           promptText="Ej: 5"
                           styleClass="campo-formulario"/>

            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">

                <Label text="Distribución de butacas"
                       styleClass="etiqueta-formulario"/>

                <TextField fx:id="campoDistribucion"
                           promptText="Ej: 4-8-4"
                           styleClass="campo-formulario"/>

            </VBox>

        </HBox>

        <Label text="Separá los bloques con guiones. Ejemplo: 4-8-4 = 16 butacas por fila."
               styleClass="subtitulo-pagina"/>

        <Label fx:id="mensajeError"
               text=""
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="mensaje-error"/>

        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Button text="Cancelar"
                    styleClass="boton-secundario"
                    onAction="#cancelar"/>

            <Button fx:id="botonGuardar"
                    text="Registrar sala"
                    styleClass="boton-primario"
                    onAction="#guardarSala"/>

        </HBox>

    </VBox>

</VBox>

